generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReportTier {
  free
  premium
}

model Assessment {
  id                String     @id @default(uuid())
  createdAt         DateTime   @default(now())
  completedAt       DateTime?
  model             String     @default("lite_v1")
  overallScore      Decimal?   @db.Decimal(3, 2)
  grade             String?
  domainScores      Json?
  email             String?
  companyName       String?
  industry          String?
  feedback          Json?
  emailCapturedAt   DateTime?
  reportTier        ReportTier @default(free)
  reportUrl         String?
  reportGeneratedAt DateTime?
  reportEmailSentAt DateTime?
  reportEmail       String?
  downloadToken     String?    @unique

  responses       Response[]
}

model Response {
  assessmentId String
  qId          String
  score        Int?
  notes        String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@id([assessmentId, qId])
  @@map("responses")
}

model Question {
  id           String @id @default(uuid())
  domain       String
  order        Int
  prompt       String
  helpText     String
  modelVersion String @default("v1.0")
  mapping      Json?

  @@unique([modelVersion, domain, order])
}